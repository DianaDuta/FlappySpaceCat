  - tipo: 3
    titulo: Capitan Estelar
    descripcion: Alcanza 100 puntos en una sola partida.
    icono: {fileID: 8501025978002714740, guid: 3faa5c6b2093db249b0df35e37e530ae, type: 3}
  - tipo: 4
    titulo: Leyenda del Cosmos
    descripcion: Alcanza 250 puntos en una sola partida.
    icono: {fileID: 4744253247010994138, guid: 6d2baae4ee7810e4f845daf002ee9e73, type: 3}
  - tipo: 5
    titulo: Agujero Negro
    descripcion: La gravedad te atrae hasta jugar 50 partidas en total
    icono: {fileID: -3950111043053983299, guid: 7ddcf5b300769b749961fc4f9eee5496, type: 3}
  - tipo: 6
    titulo: A la velocidad de la luz
    descripcion: La gravedad te atrae hasta jugar 50 partidas en total
    icono: {fileID: 2093176267527272707, guid: 90b198b7bc3886f42aa70c6a4c26a81b, type: 3}
  - tipo: 7
    titulo: Con los bolsillos llenos
    descripcion: Acumula 100 gemas
    icono: {fileID: 9135904008326009771, guid: d20bb6348965af444bfba5bebf849413, type: 3}
  - tipo: 8
    titulo: Magnate de la galaxia
    descripcion: Acumula 5000 gemas
    icono: {fileID: -6181431388360836115, guid: c9a4b02a050d76c428405f4a106d60e6, type: 3}
  - tipo: 9
    titulo: Una racha codiciosa
    descripcion: Acumula 5000 gemas.
    icono: {fileID: -6181431388360836115, guid: c9a4b02a050d76c428405f4a106d60e6, type: 3}
  - tipo: 10
    titulo: Fiebre de cristal
    descripcion: Recoge 100 gemas en una sola partida.
    icono: {fileID: 7366619717433111314, guid: 39d37f55eaaa92a48a230ad0028827aa, type: 3}
  - tipo: 11
    titulo: Avaro despistado
